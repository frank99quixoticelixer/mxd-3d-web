# GLB/GLTF/BIN van por Git LFS por defecto.
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.bin   filter=lfs diff=lfs merge=lfs -text

# Excepcion: los GLB de vitrina (los entrega /api/modelos desde
# protegido/) van como binarios normales en git: Hostinger no soporta LFS.
# La regla especifica despues de la general gana en gitattributes.
#
# Tiene que ser -text. Esta linea decia "text" y git trato los GLB como
# texto: al commitearlos cambio cada CRLF por LF y los trunco. Paso con 30
# de los 36 GLB del commit 138aae2 (visor del catalogo en blanco con
# "Invalid typed array length").
apps/vitrina/protegido/models/**/*.glb !filter !diff !merge -text

# Binarios que nunca se deben tocar, por si autocrlf decide mal.
*.stl  binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.zip  binary
*.pdf  binary
