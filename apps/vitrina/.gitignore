# ---------------------------------------------------------------
# Archivos 3D
# ---------------------------------------------------------------
# Los .blend y los escaneos crudos NO van en este repositorio:
# viven en el repositorio de assets (mxd-assets) con Git LFS.
*.blend
*.blend1
*.stl
*.ply
*.obj
# Excepcion: STL de descarga van en public/downloads/ para servirse en Hostinger
!public/downloads/**/*.stl

# Los .glb SI se versionan aqui mientras el proyecto es pequenio,
# pero con Git LFS (ver .gitattributes). Cuando migres a Cloudflare R2,
# descomenta la linea siguiente y quita los GLB del historial.
# /public/models/**/*.glb

# salidas temporales de los scripts
/scripts/salida/
