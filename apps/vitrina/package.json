{
  "name": "mxd-web",
  "version": "0.1.0",
  "private": true,
  "description": "Catalogo tecnico interactivo de piezas de drones MXD (MX30 / MX50 / MX80)",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
