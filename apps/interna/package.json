{
  "name": "mxd-interna",
  "version": "0.1.0",
  "private": true,
  "description": "Panel interno MXD — BOM, modelos y stock. Clon del catalogo de vitrina como base.",
  "scripts": {
    "predev": "node scripts/sincronizar-publico.mjs",
    "dev": "next dev --port 3002",
    "prebuild": "node scripts/sincronizar-publico.mjs",
    "build": "next build --webpack",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets:sincronizar": "node scripts/sincronizar-publico.mjs",
    "bom:migrar": "tsx scripts/migrar-a-bom.ts",
    "bom:agregar": "tsx scripts/migrar-a-bom.ts --agregar-faltantes",
    "maestro:importar": "tsx scripts/importar-maestro.ts",
    "db:migrar": "tsx --env-file=.env.local scripts/db-migrar.ts",
    "usuarios": "tsx --env-file=.env.local scripts/usuarios.ts",
    "verificar": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.0",
    "better-auth": "^1.7.19",
    "exceljs": "^4.4.0",
    "mysql2": "^3.24.6",
    "next": "^16.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.16",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.14.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
