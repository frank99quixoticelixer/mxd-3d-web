# ---------------------------------------------------------------
# MXD Interna - variables de entorno
# Copia este archivo a .env.local y ajusta los valores.
# NUNCA subas .env.local al repositorio.
# ---------------------------------------------------------------

# URL publica del sitio (se usa en metadatos y Open Graph)
NEXT_PUBLIC_SITIO_URL="http://localhost:3002"

# Origen de los modelos 3D.
#   "local" -> se sirven desde /public/models  (etapa actual, esqueleto)
#   "cdn"   -> se sirven desde NEXT_PUBLIC_ASSETS_URL (Cloudflare R2 / S3)
NEXT_PUBLIC_ORIGEN_MODELOS="local"

# Solo se usa cuando NEXT_PUBLIC_ORIGEN_MODELOS="cdn"
# Ejemplo: https://assets.mxd.com.mx
NEXT_PUBLIC_ASSETS_URL=""

# ---------------------------------------------------------------
# Acceso al panel: cuentas individuales (obligatorio, ADR 0006)
# ---------------------------------------------------------------
# Cada persona entra con su correo y contrasena (Better Auth + MySQL). Sin
# estas variables el sitio responde 503 a todo: se cierra en lugar de abrirse,
# para que un olvido de configuracion no publique el BOM.
#
# En produccion viven en hPanel, en las variables de entorno del sitio. Se leen
# en cada arranque; cambiarlas exige reiniciar el sitio, no reconstruir.
#
# Base de datos: desde la app SIEMPRE 127.0.0.1 (el host srvNNNN.hstgr.io solo
# sirve desde fuera de Hostinger).
DB_HOST="127.0.0.1"
DB_PUERTO="3306"
DB_NOMBRE=""
DB_USUARIO=""
DB_CLAVE=""

# Secreto que firma las cookies de sesion: 32 caracteres o mas, distinto en
# cada entorno. Generalo con:  openssl rand -base64 32
# Si se cambia, todas las sesiones abiertas se cierran.
BETTER_AUTH_SECRET=""

# URL publica del sitio, sin barra final. En local: http://localhost:3002
BETTER_AUTH_URL="http://localhost:3002"

# Muestra el panel de diagnostico del visor (piezas del GLB sin coincidencia en el catalogo).
# Dejalo en "true" mientras integras piezas nuevas; ponlo en "false" para produccion.
NEXT_PUBLIC_DIAGNOSTICO_3D="true"

