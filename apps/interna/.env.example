# ---------------------------------------------------------------
# MXD Interna - variables de entorno
# Copia este archivo a .env.local y ajusta los valores.
# NUNCA subas .env.local al repositorio.
# ---------------------------------------------------------------

# URL publica del sitio (se usa en metadatos y Open Graph)
NEXT_PUBLIC_SITIO_URL="http://localhost:3002"

# Origen de los modelos 3D.
#   "local" -> se sirven desde /public/models  (etapa actual, esqueleto)
#   "cdn"   -> se sirven desde NEXT_PUBLIC_ASSETS_URL (Cloudflare R2 / S3)
NEXT_PUBLIC_ORIGEN_MODELOS="local"

# Solo se usa cuando NEXT_PUBLIC_ORIGEN_MODELOS="cdn"
# Ejemplo: https://assets.mxd.com.mx
NEXT_PUBLIC_ASSETS_URL=""

# ---------------------------------------------------------------
# Acceso al panel (obligatorio)
# ---------------------------------------------------------------
# La app interna esta en un dominio publico, asi que entra por autenticacion
# HTTP basica. Sin estas dos variables el sitio responde 503 a todo: se cierra
# en lugar de abrirse, para que un olvido de configuracion no publique el BOM.
#
# En produccion viven en hPanel, en las variables de entorno del sitio. A
# diferencia de las NEXT_PUBLIC_*, estas se leen en cada peticion y no se
# hornean en el bundle: cambiar la contrasena surte efecto al reiniciar el
# sitio, sin necesidad de reconstruir. Comprobado con next start.
INTERNA_USUARIO="mxd"
INTERNA_CLAVE="cambiala-antes-de-desplegar"

# Muestra el panel de diagnostico del visor (piezas del GLB sin coincidencia en el catalogo).
# Dejalo en "true" mientras integras piezas nuevas; ponlo en "false" para produccion.
NEXT_PUBLIC_DIAGNOSTICO_3D="true"

